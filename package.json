{
  "name": "dub-visualizer",
  "productName": "dub-visualizer",
  "version": "1.0.0",
  "description": "Dubbing helper: play a video fullscreen and record a synchronized microphone take as WAV",
  "main": "src/index.js",
  "scripts": {
    "app": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "windows": "electron-forge make --platform=win32",
    "package-win": "electron-forge package --platform=win32 --arch=x64"
  },
  "keywords": [],
  "author": {
    "name": "Arnaudvitale",
    "email": "arnaud.vitale@epitech.eu"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "electron": "^45.3.2"
  },
  "build": {
    "icon": "img/recordapp"
  }
}
